{
  "name": "my-wallet",
  "main": "expo-router/entry",
  "version": "1.8.3",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "rm -rf android && APP_VARIANT=development expo run:android",
    "android:prebuild": "APP_VARIANT=development npx expo prebuild --clean",
    "android:release": "npx expo prebuild --clean && cd android && ./gradlew assembleRelease -x lint -x test",
    "ios": "APP_VARIANT=development expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "web": "expo start --web",
    "lint": "expo lint",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "check-docs": "bash scripts/check-docs.sh"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-navigation/bottom-tabs": "^7.15.5",
    "@react-navigation/elements": "^2.9.10",
    "@react-navigation/native": "^7.1.33",
    "drizzle-orm": "^0.45.2",
    "expo": "~55.0.8",
    "expo-asset": "~55.0.14",
    "expo-background-fetch": "~55.0.10",
    "expo-constants": "~55.0.9",
    "expo-contacts": "~55.0.9",
    "expo-dev-client": "~55.0.24",
    "expo-device": "~55.0.10",
    "expo-document-picker": "~55.0.9",
    "expo-file-system": "~55.0.12",
    "expo-font": "~55.0.4",
    "expo-glass-effect": "~55.0.8",
    "expo-image": "~55.0.6",
    "expo-linking": "~55.0.8",
    "expo-localization": "~55.0.9",
    "expo-location": "~55.1.4",
    "expo-router": "~55.0.7",
    "expo-sharing": "~55.0.14",
    "expo-splash-screen": "~55.0.12",
    "expo-sqlite": "~55.0.11",
    "expo-status-bar": "~55.0.4",
    "expo-symbols": "~55.0.5",
    "expo-system-ui": "~55.0.10",
    "expo-task-manager": "~55.0.10",
    "expo-web-browser": "~55.0.10",
    "i18next": "^26.0.3",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^17.0.2",
    "react-native": "^0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-expo": "^55.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
